# ---------------------------------------------------------------------------
# .env.example - Triagem de Incidentes Técnicos
# NÃO preencha com valores reais. Copie como .env e edite ali.
# ---------------------------------------------------------------------------

# --- LLM (OpenAI) ---
# Se OPENAI_API_KEY ficar vazio, a aplicação entra em modo MOCK/DEMO
# (classificações e análises por regras determinísticas, sem custo).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Low-code / No-code (n8n webhook) ---
# Se vazio, o webhook é pulado e um warning é logado.
N8N_WEBHOOK_URL=

# --- Tool (Knowledge Base de Incidentes Similares) ---
# true = usa dados mockados localmente (sem HTTP). false = chama TOOL_KB_API_URL.
TOOL_USE_MOCK=true
TOOL_KB_API_URL=https://api.publicapis.org/entries

# --- Observabilidade ---
LOG_LEVEL=INFO
# Caminho raiz para execuções, auditoria e logs persistidos.
STORAGE_PATH=./storage

# --- Governança / Limites ---
# Passos máximos no LangGraph (impede loops infinitos).
MAX_STEPS=20
# Score de prompt injection a partir do qual risco é elevado à aprovação humana.
ADVERSARIAL_THRESHOLD=0.50
# Timeout padrão em segundos para tool e LLM.
HTTP_TIMEOUT_SECONDS=5
